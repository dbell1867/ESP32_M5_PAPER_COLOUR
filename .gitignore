# PlatformIO build output + downloaded libraries (regenerated by `pio run`)
.pio/
# Editor/clangd artefacts (machine-specific; regenerate: pio run -t compiledb)
compile_commands.json
.cache/
# Simulator output (regenerate: python3 tools/epd_sim.py)
sim/
__pycache__/
# NOTE: backup/ is tracked on purpose — the off-machine copy of the factory firmware.
